{
  "name": "reckoner",
  "version": "0.1.0",
  "description": "Memory and policy package for pi — persistent learning loops, harness footer, and four phosphor terminal themes.",
  "keywords": ["pi-package", "coding-agent", "pi", "agent-workbench", "memory", "policy", "theme", "themes", "phosphor", "retro-terminal", "vt100", "amber", "terminal-theme", "harness"],
  "author": "sainzs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainzs/reckoner.git"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "verify:themes": "node scripts/validate-themes.mjs",
    "render:screenshots": "python3 scripts/render-screenshots.py",
    "verify:self": "npm run typecheck && npm run test:unit && npm run verify:themes"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  }
}
